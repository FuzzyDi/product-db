POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=product_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/product_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@db:5432/product_db
REDIS_URL=redis://redis:6379/0

# Авторизация: comma-separated ключи. Пусто = auth отключена (dev)
API_KEYS=

# Sentry (опционально)
SENTRY_DSN=

# Логирование
LOG_LEVEL=INFO
LOG_JSON=false

# Backup
BACKUP_DIR=/backups
